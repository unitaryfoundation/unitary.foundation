---
import { Swiper, SwiperWrapper, SwiperSlide, SwiperButtonPrev, SwiperButtonNext } from 'astro-swiper';
import type { CollectionEntry } from 'astro:content';

import { BlogItem } from '~/components/Pages/Blog/Content/BlogItem';
import arrowUrl from '~/assets/svg/arrow.svg?url';

type Props = {
  posts: Array<CollectionEntry<'blog'>>;
};

const { posts } = Astro.props;
---
{ !!posts?.length ? (
  <Swiper
    class="w-full"
    options={{
      spaceBetween: 30,
      slidesPerView: 1,
      navigation: {
        prevEl: '.myswiper-button-prev',
        nextEl: '.myswiper-button-next',
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
          slidesPerGroup: 2,
          noSwiping: true,
          noSwipingClass: 'swiper-slide',
        },
      }
    }}>
    <SwiperWrapper>
      {posts.map((post) => (
        <SwiperSlide class="swiper-slide !h-auto">
          <BlogItem post={post} className="h-full" client:load />
        </SwiperSlide>
      ))}
    </SwiperWrapper>
    <div class="flex mt-5 md:mt-14 gap-x-2">
      <SwiperButtonPrev
        class="myswiper-button-prev flex items-center cursor-pointer px-3 justify-start md:justify-center w-1/2 md:w-[50px] h-[35px] bg-black"
        title="Prev"
        addDefaultClass={false}>
        <img src={arrowUrl} alt="Arrow icon" class="rotate-180" />
      </SwiperButtonPrev>
      <SwiperButtonNext
        class="myswiper-button-next flex items-center cursor-pointer px-3 justify-end md:justify-center w-1/2 md:w-[50px] h-[35px] bg-black"
        title="Next"
        addDefaultClass={false}>
        <img src={arrowUrl} alt="Arrow icon" />
      </SwiperButtonNext>
    </div>
  </Swiper>
) : null}
